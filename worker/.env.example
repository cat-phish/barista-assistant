# Only for running the worker on your machine (npm run dev), outside Docker,
# against the db/redis containers. Copy to worker/.env (git-ignored) and
# chmod 600 it. Use the same values as the root .env.
#
# Each secret can also be given as NAME_FILE=/path/to/file instead of NAME.

# No password in the URL: it's passed separately so the URL never holds a secret.
DATABASE_URL=mysql://barista@localhost:3306/coffee_journal
# = MARIADB_PASSWORD in the root .env
DATABASE_PASSWORD=

REDIS_URL=redis://localhost:6379
# = REDIS_PASSWORD in the root .env
REDIS_PASSWORD=

OPENAI_API_KEY=
# Required; must support Structured Outputs (strict JSON schema).
OPENAI_MODEL=
# Optional: point the OpenAI SDK at a compatible server instead of api.openai.com.
# OPENAI_BASE_URL=

# Jobs processed in parallel (default 2).
# WORKER_CONCURRENCY=2
