# Copy to .env, fill in, and lock it down:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and excluded from Docker images. docker compose reads it
# and hands the secrets to containers as files (/run/secrets/...), not as
# environment variables. Never paste these values into chats, issues or logs.
#
# Generate each secret instead of inventing one. Use hex: it's URL-safe, so it
# can't break connection URLs.
#   openssl rand -hex 32

# --- Secrets (all required; containers refuse to start if one is empty) ---

# MariaDB root account. Nothing in the app uses it; it only needs to be strong.
MARIADB_ROOT_PASSWORD=
# Password for the `barista` database user the backend and worker connect as.
MARIADB_PASSWORD=
# Redis password (queue between backend and worker).
REDIS_PASSWORD=
# Signs session cookies. At least 32 characters. Changing it logs everyone out.
JWT_SECRET=
# Used only by the worker.
OPENAI_API_KEY=

# --- Settings (not secret) ---

# Model the worker uses for brew analysis. Required; must support Structured
# Outputs (strict JSON schema).
OPENAI_MODEL=
