{
  "name": "@barista/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Drizzle schema and BullMQ job contracts shared by backend and worker",
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "default": "./dist/notify.js"
    },
    "./brew": {
      "types": "./dist/brew.d.ts",
      "default": "./dist/brew.js"
    },
    "./aiDetails": {
      "types": "./dist/aiDetails.d.ts",
      "default": "./dist/aiDetails.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
